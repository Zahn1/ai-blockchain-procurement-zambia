// Off-chain data for the procurement back end (PostgreSQL). Personal data lives here, never on the ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Chapter 3: administrator, procurement officer, bidder and regulator (3.5.1), evaluation committee (3.5.5), inspector (3.5.6).
enum Role {
  ADMIN
  OFFICER
  COMMITTEE
  INSPECTOR
  SUPPLIER
  REGULATOR
}

enum Status {
  ACTIVE
  SUSPENDED
}

model ProcuringEntity {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. MOH
  name      String
  status    Status   @default(ACTIVE)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  phone          String? // for SMS notifications (3.5.10), international format, e.g. +260971234567
  passwordHash   String
  role           Role
  status         Status           @default(ACTIVE)
  entityId       String?
  entity         ProcuringEntity? @relation(fields: [entityId], references: [id])
  supplierId     String? // PACRA number of the bidder's company
  supplier       Supplier?        @relation(fields: [supplierId], references: [pacraNumber])
  fabricIdentity String?          @unique // enrolled ledger identity that signs this user's transactions (committee members)

  totpSecret   String? // AES-256-GCM encrypted with APP_KEY
  totpEnabled  Boolean   @default(false)
  totpLastStep Int? // last accepted time step, so a code cannot be reused
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  auditLogs        AuditLog[]
  committees       CommitteeMember[]
  scores           Score[]
  publishedTenders Tender[]          @relation("PublishedBy")
  recommendations  Recommendation[]
  inspecting       Contract[]        @relation("Inspector")
  certified        Milestone[]       @relation("CertifiedBy")
  alertDecisions   AlertDecision[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum SupplierStatus {
  VERIFIED
  SUSPENDED
}

/// Chapter 3, 3.5.2: every supplier record is keyed to its PACRA registration number.
model Supplier {
  pacraNumber        String         @id
  companyName        String // as registered at PACRA
  tpin               String         @unique // ZRA taxpayer number
  supplierRef        String         @unique // ledger pseudonym, one per company, e.g. SUP-7K2Q9F
  status             SupplierStatus @default(VERIFIED)
  pacraStatus        String
  taxClearanceNumber String
  taxClearanceExpiry DateTime
  verifiedAt         DateTime
  users              User[]
  bids               Bid[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

/// Off-chain details of a tender. The ledger holds its hashes, value, closing time and status (3.5.3).
model Tender {
  reference        String            @id
  title            String
  fileName         String
  docHash          String
  cid              String
  closingTime      DateTime
  txId             String
  block            Int
  publishedById    String
  publishedBy      User              @relation("PublishedBy", fields: [publishedById], references: [id])
  // Evaluation method (3.5.5): combined score = technical x weight + financial x (100 - weight)
  technicalWeight  Int               @default(70)
  passMark         Int               @default(60)
  // Who can open the bids (FR-BID-07): SERVER (the back end's master key) or SHAMIR (a quorum of the committee's
  // key shares). With SHAMIR, bid keys are wrapped with this X25519 public key; its private key exists only as shares.
  openingMode      String            @default("SERVER")
  openingPublicKey String?
  committee        CommitteeMember[]
  bids             Bid[]
  recommendation   Recommendation?
  contract         Contract?
  createdAt        DateTime          @default(now())
}

/// Off-chain details of a sealed bid. The ledger holds its ciphertext hash and submission time (3.5.4).
model Bid {
  bidId       String    @id
  tenderRef   String
  tender      Tender    @relation(fields: [tenderRef], references: [reference])
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [pacraNumber])
  supplierRef String
  fileName    String
  cid         String
  cipherHash  String
  txId        String
  submittedAt DateTime
  // Opening (3.5.5)
  integrity   String? // MATCH or MISMATCH: the stored file checked against the ledger hash
  plainHash   String?
  openedAt    DateTime?
  priceNgwee  BigInt? // bid price read from the opened document
  wrappedKey  String? // SHAMIR opening: the bid key wrapped with the tender's public key until opening
  scores      Score[]

  @@index([tenderRef])
}

/// The evaluation committee appointed for a tender (3.5.5).
model CommitteeMember {
  tenderRef         String
  tender            Tender    @relation(fields: [tenderRef], references: [reference])
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  approvedAt        DateTime? // when this member signed the opening approval on the ledger
  approvalTxId      String?
  // SHAMIR opening: this member's key share. Held (sealed) only until the member downloads it; its hash checks the
  // share they hand back at opening, which is held (sealed) only until the bids are opened.
  shareIndex        Int?
  shareHash         String?
  shareSealed       String?
  shareDownloadedAt DateTime?
  sharePending      String?

  @@id([tenderRef, userId])
}

/// One committee member's technical score for one bid (3.5.5).
model Score {
  bidId          String
  bid            Bid      @relation(fields: [bidId], references: [bidId])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  technicalScore Int
  comment        String
  updatedAt      DateTime @updatedAt

  @@id([bidId, userId])
}

/// The committee's award recommendation; a written justification is required if it departs from the top-ranked bid.
model Recommendation {
  tenderRef        String   @id
  tender           Tender   @relation(fields: [tenderRef], references: [reference])
  bidId            String
  recommendedBidId String // the bid the scores ranked first
  justification    String?
  report           Json // the full evaluation as recorded
  reportHash       String // SHA-256 of the report; goes on the ledger with the award (3.5.6)
  decidedById      String
  decidedBy        User     @relation(fields: [decidedById], references: [id])
  createdAt        DateTime @default(now())
}

/// Off-chain details of an awarded contract (3.5.6). The ledger holds the award, contract hash and milestones.
model Contract {
  awardId          String      @id
  tenderRef        String      @unique
  tender           Tender      @relation(fields: [tenderRef], references: [reference])
  bidId            String
  supplierRef      String
  amountNgwee      BigInt
  evalHash         String // the evaluation report hash recorded with the award (3.5.5)
  awardTxId        String
  awardedAt        DateTime
  standstillEnds   DateTime
  status           String // AWARDED or SIGNED, as on the ledger
  contractFileName String?
  contractCid      String?
  contractHash     String?
  signTxId         String?
  signedAt         DateTime?
  inspectorId      String? // the authorised inspector for this contract
  inspector        User?       @relation("Inspector", fields: [inspectorId], references: [id])
  milestones       Milestone[]
  createdAt        DateTime    @default(now())
}

/// One milestone of a contract: its terms, the inspector's certificate and the payment (3.5.6).
model Milestone {
  awardId             String
  contract            Contract  @relation(fields: [awardId], references: [awardId])
  milestoneId         String
  description         String
  amountNgwee         BigInt
  dueDate             DateTime
  // Completion certificate
  certificateFileName String?
  certificateCid      String?
  certificateHash     String?
  completionDate      DateTime?
  certifiedById       String?
  certifiedBy         User?     @relation("CertifiedBy", fields: [certifiedById], references: [id])
  certifyTxId         String?
  // Payment through IFMIS
  paymentStatus       String? // HELD (with the ledger's reason) or PAID
  paymentNote         String?
  paymentId           String?
  ifmisRef            String?
  paymentTxId         String?
  paidAt              DateTime?

  @@id([awardId, milestoneId])
}

/// A regulator's decision on an AI alert (3.5.8). The record's SHA-256 hash is on the ledger with the decision.
model AlertDecision {
  id          String   @id @default(uuid())
  alertId     String
  subjectId   String
  decision    String // CLEARED, MONITOR or REFERRED
  reason      String
  record      Json // exactly what was hashed
  recordHash  String
  decidedById String
  decidedBy   User     @relation(fields: [decidedById], references: [id])
  txId        String
  createdAt   DateTime @default(now())

  @@index([alertId])
}

/// An AI risk alert (3.5.7): the score, the model version and the plain-English explanation. The explanation's
/// SHA-256 hash is on the ledger with the alert (AlertContract), raised by the AI service's own identity.
model RiskAlert {
  alertId         String   @id
  subjectType     String // tender or contract
  subjectId       String
  event           String // e.g. TENDER_AWARDED, MILESTONE_CERTIFIED
  score           Int
  modelVersion    String
  explanation     Json
  explanationHash String
  txId            String
  createdAt       DateTime @default(now())

  @@index([subjectId])
}

/// Every e-mail and SMS notification sent for a key event (3.5.10).
model Notification {
  id          String   @id @default(uuid())
  event       String // TENDER_PUBLISHED, BID_RECEIVED, CONTRACT_AWARDED, PAYMENT_MADE
  channel     String // EMAIL or SMS
  recipient   String
  subject     String?
  body        String
  status      String // SENT or FAILED
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([event])
}

/// Who did what and when (FR-AUD-02).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
