{
  "name": "procurement-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API for the transparent procurement prototype: Fabric gateway, IPFS and sealed bids",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@hyperledger/fabric-gateway": "^1.11.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.2",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "shamir-secret-sharing": "^0.0.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.13.0",
    "supertest": "^7.3.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./test/global-setup.js"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
